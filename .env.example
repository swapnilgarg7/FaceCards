# Copy to .env and adjust. .env is gitignored.

# --- Game server ---
PORT=2567
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Media (LiveKit) ---
# Local Docker SFU, started with `npm run livekit:up`. These dev credentials
# match docker/livekit/livekit.yaml and are not secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# For LiveKit Cloud instead, take all three from the project dashboard:
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=<from dashboard>
# LIVEKIT_API_SECRET=<from dashboard>

# --- Client (Vite; only VITE_-prefixed vars reach the browser) ---
VITE_SERVER_HTTP_URL=http://localhost:2567
VITE_SERVER_WS_URL=ws://localhost:2567
